{
  "name": "mass-effect-refuse-film",
  "version": "0.1.0",
  "private": true,
  "description": "MASS EFFECT: REFUSE — The Ending We Earned. An unofficial fan-made animated alternate ending to Mass Effect 3, produced with Remotion.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audio": "tsx scripts/audio/generate-audio.ts",
    "render:scene": "bash scripts/render-scene.sh",
    "render:chapter": "bash scripts/render-chapter.sh",
    "render:film": "bash scripts/render-film.sh",
    "render:trailer": "bash scripts/render-trailer.sh",
    "frames": "tsx scripts/capture-frames.ts",
    "site:build": "bash scripts/build-site.sh",
    "site:preview": "npx serve dist-site"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.534",
    "@remotion/cli": "^4.0.534",
    "@remotion/renderer": "^4.0.534",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
